list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

round: ( )
box: [ ]
diamond: < >
curly: { }
pair singles: "' '"
pair doubles: '" "'
pair back tics | pair graves: ` `
pair percents: % %
pad out: space space

real doubles: '\\" \\"'
real singles: "\\' \\'"
real round: \( \)
real box: \[ \]
real curly: \{ \}

