list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

round: ( )
box: [ ]
diamond: < >
curly: { }
post pair: "' '"
double pair: '" "'
grave pair: ` `
percent pair: % %
dollar pair: $ $
pad out: space space

real double pair: '\\" \\"'
real post pair: "\\' \\'"
real round: \( \)
real box: \[ \]
real curly: \{ \}

